<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <!-- The built files name their sources from /_/ on, not from the folder they were built in. -->
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The game's Oodle library is a 64-bit DLL, so every program that may load it runs as a 64-bit process. -->
    <PlatformTarget>x64</PlatformTarget>
    <Version>1.2.0</Version>
    <Authors>Awaydays</Authors>
    <Product>GRB Animation Tool</Product>
    <Copyright>Copyright (C) 2026 Awaydays</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>
</Project>
