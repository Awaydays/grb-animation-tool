<UserControl x:Class="GrbAnimTool.App.EditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GrbAnimTool.App"
             xmlns:index="clr-namespace:GrbAnimTool.Core.Index;assembly=GrbAnimTool.Core"
             xmlns:lib="clr-namespace:GrbAnimTool.Core.Library;assembly=GrbAnimTool.Core">
    <UserControl.Resources>
        <!-- the styles build on the theme's own (BasedOn), so the controls keep its look in light and dark -->
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource Grb.TextSecondary}" />
            <Setter Property="Margin" Value="0,3,8,3" />
        </Style>
        <!-- an edit's greyed-out reason ("Unavailable: ...") in red, and its warnings in amber -->
        <Style x:Key="Reason" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource Grb.Error}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="20,0,0,2" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="Warning" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource Grb.Warning}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="20,0,0,2" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <!-- the theme's radio button is 32 high around its 20 high circle and word: the negative margins give the edits' list the
             spacing it had before the theme, so the checks below keep their room -->
        <Style x:Key="EditChoice" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="GroupName" Value="EditKind" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,-2,0,-4" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- the clip being edited -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="UseLibraryButton" Content="Use the Library's clip" Click="OnUseLibraryClip" IsEnabled="False" ToolTipService.ShowOnDisabled="True"
                    ToolTip="Edits the clip shown on the Library screen." />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0">
                <TextBlock x:Name="ClipText" Text="Open your game folder on the Library screen first." TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                <TextBlock x:Name="ClipInfo" Foreground="{DynamicResource Grb.TextSecondary}" TextTrimming="CharacterEllipsis" />
                <!-- who plays the clip ("probably" explained on hover), and, when that is more than one kind of
                     character or none the tool can place, a notice that never stops the edit -->
                <TextBlock x:Name="UsersText" Foreground="{DynamicResource Grb.TextSecondary}" TextWrapping="Wrap"
                           ToolTip="{x:Static index:ClipUsers.PlayedByTip}" />
                <TextBlock x:Name="UsersNotice" Foreground="{DynamicResource Grb.Warning}" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel x:Name="BusyPanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                <ProgressBar IsIndeterminate="True" Width="140" Height="14" Margin="0,0,8,0" />
                <TextBlock x:Name="BusyText" Text="Working..." />
            </StackPanel>
        </Grid>

        <Border x:Name="ErrorBox" Grid.Row="1" Background="{DynamicResource Grb.ErrorBack}" BorderBrush="{DynamicResource Grb.ErrorBorder}" BorderThickness="1" Padding="8,5" Margin="0,0,0,6"
                Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Dismiss" Click="OnDismissError" Margin="8,0,0,0" VerticalAlignment="Top" />
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource Grb.Error}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- the panes fill the window's height, and scroll in a window too short for their least height: every edit, its reason, the
             Apply buttons and a few lines of the checks stay reachable -->
        <local:FitScroll x:Name="PaneScroll" Grid.Row="2">
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- in proportion, so all three panes stay in the window down to its least size: at the usual size the list has room for
                     its four first columns (name, readable name, who, what) and the edits each clip allows -->
                <ColumnDefinition Width="665*" MinWidth="280" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="410*" MinWidth="280" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="405*" MinWidth="250" />
            </Grid.ColumnDefinitions>

            <!-- the clip picker -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Clip" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" />
                <!-- the clip list every screen uses -->
                <local:ClipListPanel x:Name="ClipPanel" />
            </DockPanel>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{DynamicResource Grb.Splitter}" />

            <!-- the result and the original as a ghost, on one timeline -->
            <Grid x:Name="ViewerPane" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <WrapPanel Grid.Row="0" Margin="0,0,0,4">
                    <CheckBox x:Name="MoverBox" Content="Mover" IsChecked="True" Margin="0,3,12,3" Click="OnViewToggled" Focusable="False"
                              ToolTip="On: both travel and turn on their movers. Off: both play in place." />
                    <CheckBox x:Name="GhostBox" Content="Original as a ghost" IsChecked="True" Margin="0,3,12,3" Click="OnViewToggled" Focusable="False"
                              ToolTip="The game's clip drawn pale beside or behind the result: in its own time, or at the result's progress with the box beside this one." />
                    <CheckBox x:Name="FollowsEditBox" Content="Original follows the edit's progress" IsChecked="False" Margin="0,3,12,3" Click="OnFollowsEditToggled" Focusable="False"
                              ToolTip="Off (the usual): the original plays in real time at 1x and loops at its own length, so a speed change or a trim shows as a difference in timing. On: the original stands at the point of its move that plays at each tick of the result, to compare poses at the same point of the move (mostly useful in Overlay). Remembered for the next run, on the Import screen too." />
                    <CheckBox x:Name="FollowBox" Content="Follow character" IsChecked="True" Margin="0,3,12,3" Click="OnFollowToggled" Focusable="False"
                              ToolTip="Keep the camera on the result as it travels (with Mover on), so a travelling clip and its ghost stay in view." />
                    <ComboBox x:Name="LayoutBox" Width="130" Margin="0,0,12,0" VerticalAlignment="Center" SelectionChanged="OnLayoutChosen" Focusable="False"
                              ToolTip="Overlay: the original drawn pale behind the result, to see exactly how far the travel or a few bones changed. Side by side: the two apart, never overlapping, for an edit whose timing or whole motion differs. Every edit starts side by side, except root-motion scale, which starts in Overlay; a choice made here holds for every edit after it while the program runs.">
                        <ComboBoxItem Content="Overlay" />
                        <ComboBoxItem Content="Side by side" />
                    </ComboBox>
                    <Button Content="Reset camera" Click="OnResetCamera" Focusable="False" />
                    <TextBlock x:Name="LegendText" Text="Blue: the result · pale: the original · cyan: a planted foot · red: a foot below the floor" Foreground="{DynamicResource Grb.TextSecondary}"
                               VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap" />
                </WrapPanel>
                <Border x:Name="ViewFrame" Grid.Row="1" BorderBrush="{DynamicResource Grb.ViewBorder}" BorderThickness="1">
                    <Grid>
                        <Border x:Name="ViewSurface" Background="{DynamicResource Grb.ViewBack}" ClipToBounds="True" Focusable="True" FocusVisualStyle="{x:Null}">
                            <Viewport3D x:Name="Viewport" IsHitTestVisible="False" ClipToBounds="True">
                                <ModelVisual3D>
                                    <ModelVisual3D.Content>
                                        <Model3DGroup>
                                            <AmbientLight Color="#FF505050" />
                                            <DirectionalLight Color="#FFC8C8C8" Direction="-0.4,-0.6,-1" />
                                            <DirectionalLight Color="#FF707070" Direction="0.5,0.7,-0.3" />
                                        </Model3DGroup>
                                    </ModelVisual3D.Content>
                                </ModelVisual3D>
                            </Viewport3D>
                        </Border>
                        <local:SketchLayer x:Name="Sketch" Visibility="Collapsed" />
                        <TextBlock x:Name="OverlayText" Foreground="{DynamicResource Grb.ViewText}" Margin="10,8" VerticalAlignment="Top" HorizontalAlignment="Left"
                                   IsHitTestVisible="False" FontFamily="Consolas" TextWrapping="Wrap" />
                        <TextBlock x:Name="HintText" Foreground="{DynamicResource Grb.ViewHint}" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   IsHitTestVisible="False" TextWrapping="Wrap" TextAlignment="Center" Text="Choose a clip to edit." />
                    </Grid>
                </Border>
                <!-- the timeline: each strip the viewer's whole width under a line naming it (the trim's handles over the original's
                     length, then the shown clip's events and plants), then the play row with its slider, then the time and Loop -->
                <StackPanel x:Name="TimelinePanel" Grid.Row="2" Margin="0,6,0,0" Background="Transparent">
                    <WrapPanel x:Name="TrimLabel" Margin="4,0,8,1" Visibility="Collapsed">
                        <TextBlock Text="trim: " Foreground="{DynamicResource Grb.TextSecondary}" FontSize="10" />
                        <TextBlock x:Name="TrimValue" Foreground="{DynamicResource Grb.TextSecondary}" FontSize="10" TextWrapping="Wrap" />
                    </WrapPanel>
                    <Border x:Name="TrimBorder" Height="26" Margin="4,0,8,4" Background="{DynamicResource Grb.Strip}" BorderBrush="{DynamicResource Grb.StripBorder}" BorderThickness="1"
                            Visibility="Collapsed" ToolTip="Drag the two handles to the first and the last tick of the original to keep.">
                        <Canvas x:Name="TrimCanvas" Margin="5,0,5,0" SizeChanged="OnTrimSized" Background="Transparent">
                            <Rectangle x:Name="TrimKept" Height="10" Canvas.Top="7" Fill="{DynamicResource Grb.TrimKept}" />
                            <Thumb x:Name="FromThumb" Width="10" Height="24" Canvas.Top="0" DragDelta="OnFromDragged" Cursor="SizeWE" ToolTip="The first tick kept" />
                            <Thumb x:Name="ToThumb" Width="10" Height="24" Canvas.Top="0" DragDelta="OnToDragged" Cursor="SizeWE" ToolTip="The last tick kept" />
                        </Canvas>
                    </Border>
                    <WrapPanel Margin="4,0,8,1">
                        <TextBlock Text="events · plants L/R: " Foreground="{DynamicResource Grb.TextSecondary}" FontSize="10" />
                        <TextBlock x:Name="MarkText" Foreground="{DynamicResource Grb.TextSecondary}" FontSize="10" />
                    </WrapPanel>
                    <Border Height="24" Margin="4,0,8,4" Background="{DynamicResource Grb.Strip}" BorderBrush="{DynamicResource Grb.StripBorder}" BorderThickness="1">
                        <Canvas x:Name="MarkStrip" Margin="5,0,5,0" ClipToBounds="True" SizeChanged="OnMarkStripSized" Background="Transparent" />
                    </Border>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button x:Name="StepBackButton" Content="◀|" Click="OnStepBack" ToolTip="One tick back (Left arrow)" Focusable="False" />
                            <Button x:Name="PlayButton" Content="▶ Play" Width="80" Click="OnPlayPause" ToolTip="Play or pause (Space)" Focusable="False" />
                            <Button x:Name="StepForwardButton" Content="|▶" Click="OnStepForward" ToolTip="One tick forward (Right arrow)" Focusable="False" />
                        </StackPanel>
                        <Slider x:Name="TimeSlider" Minimum="0" Maximum="1" VerticalAlignment="Center" Margin="4,0,8,0" MinWidth="0"
                                ValueChanged="OnScrub" SmallChange="0.0166667" LargeChange="0.5" IsMoveToPointEnabled="True" Focusable="False" />
                    </DockPanel>
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                        <TextBlock x:Name="TimeText" MinWidth="190" FontFamily="Consolas" VerticalAlignment="Center" Text="0.000 s  tick 0 / 0" />
                        <CheckBox x:Name="LoopBox" Content="Loop" IsChecked="True" Margin="6,0,0,0" VerticalAlignment="Center" Click="OnLoopToggled" Focusable="False" />
                    </WrapPanel>
                </StackPanel>
            </Grid>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="{DynamicResource Grb.Splitter}" />

            <!-- the edits, then the checks of the result -->
            <Grid x:Name="EditsPane" Grid.Column="4" Margin="6,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- the edits scroll on their own when the pane is too short for them and a few lines of the checks: the Apply buttons
                     under them stay in sight, and the screen itself scrolls only in a window too short for all that -->
                <ScrollViewer x:Name="ChoicesScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel x:Name="ChoicesPanel" Margin="0,0,10,0">
                    <TextBlock Text="Edits" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock x:Name="OptionsText" Foreground="{DynamicResource Grb.TextSecondary}" TextWrapping="Wrap" FontSize="11" Text="Choose a clip: the edits it can take show here." />

                    <RadioButton x:Name="MirrorChoice" Style="{StaticResource EditChoice}" Content="Mirror" Checked="OnKindChosen" IsEnabled="False"
                                 ToolTip="Mirrors the clip in place through the body's middle: left becomes right, its travel and turn the other way." />
                    <TextBlock x:Name="MirrorReason" Style="{StaticResource Reason}" Visibility="Collapsed" />
                    <TextBlock x:Name="MirrorWarning" Style="{StaticResource Warning}" Visibility="Collapsed" />

                    <RadioButton x:Name="ScaleChoice" Style="{StaticResource EditChoice}" Content="Root-motion scale" Checked="OnKindChosen" IsEnabled="False"
                                 ToolTip="Scales how far the character travels; the planted feet are held where they stood." />
                    <TextBlock x:Name="ScaleReason" Style="{StaticResource Reason}" Visibility="Collapsed" />
                    <TextBlock x:Name="ScaleWarning" Style="{StaticResource Warning}" Visibility="Collapsed" />
                    <DockPanel x:Name="ScalePanel" Margin="20,0,0,0" IsEnabled="False">
                        <TextBlock x:Name="ScaleValue" DockPanel.Dock="Right" Width="44" Text="1.50x" VerticalAlignment="Center" />
                        <!-- the theme's slider is 32 high around its 20 high thumb -->
                        <Slider x:Name="ScaleSlider" Minimum="0.25" Maximum="2" Value="1.5" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="OnFactorChanged"
                                Margin="0,-4" />
                    </DockPanel>
                    <!-- the scales that work on this clip, when not all do: the slider snaps to them -->
                    <TextBlock x:Name="ScaleRangeText" Margin="20,0,0,2" Foreground="{DynamicResource Grb.TextSecondary}" TextWrapping="Wrap" FontSize="11" Visibility="Collapsed" />

                    <RadioButton x:Name="SpeedChoice" Style="{StaticResource EditChoice}" Content="Speed" Checked="OnKindChosen" IsEnabled="False"
                                 ToolTip="Plays the clip faster or slower: its length, events and plants change with it." />
                    <TextBlock x:Name="SpeedReason" Style="{StaticResource Reason}" Visibility="Collapsed" />
                    <TextBlock x:Name="SpeedWarning" Style="{StaticResource Warning}" Visibility="Collapsed" />
                    <DockPanel x:Name="SpeedPanel" Margin="20,0,0,0" IsEnabled="False">
                        <TextBlock x:Name="SpeedValue" DockPanel.Dock="Right" Width="44" Text="1.25x" VerticalAlignment="Center" />
                        <Slider x:Name="SpeedSlider" Minimum="0.5" Maximum="2" Value="1.25" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="OnFactorChanged"
                                Margin="0,-4" />
                    </DockPanel>
                    <!-- the speeds that work on this clip, when not all do: the slider snaps to them -->
                    <TextBlock x:Name="SpeedRangeText" Margin="20,0,0,2" Foreground="{DynamicResource Grb.TextSecondary}" TextWrapping="Wrap" FontSize="11" Visibility="Collapsed" />

                    <RadioButton x:Name="TrimChoice" Style="{StaticResource EditChoice}" Content="Trim" Checked="OnKindChosen" IsEnabled="False"
                                 ToolTip="Cuts the clip to a part of it: drag the handles over the timeline." />
                    <TextBlock x:Name="TrimReason" Style="{StaticResource Reason}" Visibility="Collapsed" />
                    <TextBlock x:Name="TrimWarning" Style="{StaticResource Warning}" Visibility="Collapsed" />
                    <!-- the cuts that work on this clip, when not all of those tried do -->
                    <TextBlock x:Name="TrimRangeText" Margin="20,0,0,2" Foreground="{DynamicResource Grb.TextSecondary}" TextWrapping="Wrap" FontSize="11" Visibility="Collapsed" />
                    <TextBlock x:Name="TrimHint" Margin="20,0,0,0" Foreground="{DynamicResource Grb.TextSecondary}" TextWrapping="Wrap" FontSize="11"
                               Text="Drag the trim handles over the timeline." Visibility="Collapsed" />
                    <!-- the cut the handles give, tried in the background once they stop: a cut that can't be made says why -->
                    <TextBlock x:Name="TrimCheckText" Style="{StaticResource Reason}" Visibility="Collapsed" />

                    <!-- trim and speed refused for the clip's timing data: what that means, and what still works -->
                    <local:HelpButton x:Name="TimingHelp" Heading="Trim and Speed refused" Text="{x:Static lib:HelpTexts.TimingRefused}" HorizontalAlignment="Left" Margin="20,0,0,2" Visibility="Collapsed" />

                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="SwapChoice" Style="{StaticResource EditChoice}" Content="Swap" Checked="OnKindChosen" IsEnabled="False"
                                     ToolTip="Plays another clip's motion in this clip's place. Only clips of the same length with the identical track list are offered." />
                        <local:HelpButton x:Name="SwapHelp" Heading="Swap" Text="{x:Static lib:HelpTexts.Swap}" />
                    </StackPanel>
                    <TextBlock x:Name="SwapReason" Style="{StaticResource Reason}" Visibility="Collapsed" />
                    <TextBlock x:Name="SwapWarning" Style="{StaticResource Warning}" Visibility="Collapsed" />
                    <DockPanel x:Name="SwapPanel" Margin="20,0,0,0" IsEnabled="False">
                        <TextBlock DockPanel.Dock="Left" Text="Source" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,6,8,0" />
                        <!-- the sources' names run to more than 70 characters and those of one group differ only at their end, longer than the
                             box can show: the chosen one is written whole under it (and in its tooltip), the box's own text ends in an ellipsis -->
                        <TextBlock x:Name="SourceName" DockPanel.Dock="Bottom" Text="{Binding SelectedItem.Name, ElementName=SourceBox, TargetNullValue='', FallbackValue=''}" TextWrapping="Wrap"
                                   FontSize="11" Margin="0,2,0,2">
                            <TextBlock.Style>
                                <!-- the colour as a style setter, not a local value, so the greying trigger of the base style wins -->
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground" Value="{DynamicResource Grb.TextSecondary}" />
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- a clip may have hundreds of swap sources: its open list realises the rows in sight only (a virtualizing panel, and
                             the drop-down's scroll viewer scrolling by rows: scrolling by pixels, it measured the panel at full height) -->
                        <ComboBox x:Name="SourceBox" SelectionChanged="OnSourceChosen" TextSearch.TextPath="Name" ToolTip="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}}"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </DockPanel>

                    <!-- Replace: another game clip's motion or a .glb on this clip, fitted to its exact length; the clip keeps its events -->
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <RadioButton x:Name="ReplaceChoice" Style="{StaticResource EditChoice}" Content="Replace" Checked="OnKindChosen" IsEnabled="False"
                                     ToolTip="Puts another game clip's motion, or a .glb's, on this clip, fitted to its exact length. The clip keeps its own events." />
                        <local:HelpButton x:Name="ReplaceHelp" Heading="Replace" Text="{x:Static lib:HelpTexts.Replace}" />
                    </StackPanel>
                    <!-- never greyed whole, so its help stays readable: Apply waits for a clip, a source and a fit that reads -->
                    <StackPanel x:Name="ReplacePanel" Margin="20,0,0,0">
                        <WrapPanel>
                            <RadioButton x:Name="FromClipChoice" GroupName="ReplaceSource" Content="Game clip" IsChecked="True" Margin="0,0,12,0" Checked="OnReplaceChanged" />
                            <RadioButton x:Name="FromGlbChoice" GroupName="ReplaceSource" Content=".glb file" Checked="OnReplaceChanged" />
                        </WrapPanel>
                        <StackPanel x:Name="FromClipPanel">
                            <DockPanel>
                                <CheckBox x:Name="ShowEveryClipBox" DockPanel.Dock="Right" Content="Show every clip" VerticalAlignment="Center" Margin="6,0,0,0"
                                          Checked="OnShowEveryClip" Unchecked="OnShowEveryClip"
                                          ToolTip="Also lists the clips this clip can't take (on another skeleton whose bones don't map onto its own), greyed, each with why" />
                                <TextBox x:Name="ReplaceSearch" Margin="0,2" TextChanged="OnReplaceSearch" ToolTip="Words of the source clip's name, or its ID in hex, as the Library's search takes them" />
                            </DockPanel>
                            <!-- only the clips the clip (or every clip ticked) can take: on its skeleton, or one whose bones map onto it; with Show
                                 every clip the others too, greyed, with why -->
                            <ListBox x:Name="ReplaceList" Height="120" SelectionChanged="OnReplaceSourceChosen" VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="IsEnabled" Value="{Binding Takes, Mode=OneWay}" />
                                        <Setter Property="ToolTip" Value="{Binding Refusal, Mode=OneWay}" />
                                        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock TextTrimming="CharacterEllipsis" FontSize="11">
                                            <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Duration, Mode=OneWay, StringFormat=F3}" /><Run Text=" s  " /><Run Text="{Binding Note, Mode=OneWay}" Foreground="{DynamicResource Grb.TextSecondary}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                        <WrapPanel x:Name="FromGlbPanel" Visibility="Collapsed">
                            <Button x:Name="ReplaceGlbButton" Content="Choose .glb..." Click="OnReplaceGlb" Margin="0,2,6,2" />
                            <TextBlock x:Name="ReplaceGlbText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="11" />
                        </WrapPanel>
                        <TextBlock x:Name="ReplaceSourceText" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Grb.TextSecondary}" Margin="0,2" />
                        <StackPanel x:Name="FitPanel" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Fit" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <local:HelpButton x:Name="FitHelp" Heading="Fit" Text="{x:Static lib:HelpTexts.Fit}" />
                            </StackPanel>
                            <WrapPanel>
                                <RadioButton x:Name="CutChoice" GroupName="FitMode" Content="Cut" IsChecked="True" Margin="0,0,10,0" Checked="OnReplaceChanged" />
                                <RadioButton x:Name="StretchChoice" GroupName="FitMode" Content="Speed" Margin="0,0,10,0" Checked="OnReplaceChanged" />
                                <RadioButton x:Name="HoldChoice" GroupName="FitMode" Content="Hold" Checked="OnReplaceChanged" />
                            </WrapPanel>
                            <WrapPanel x:Name="CutPanel">
                                <TextBlock Text="Start frame" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                <local:NumberBox x:Name="CutStartBox" Width="64" Text="0" TextChanged="OnReplaceNumbers" />
                                <Button x:Name="SuggestButton" Content="Suggest" Click="OnSuggestCut" Margin="6,0,0,0" ToolTip="The start where the cut's first and last frames match best, so the loop closes best" />
                            </WrapPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <CheckBox x:Name="LoopFitBox" Content="Seamless loop" VerticalAlignment="Center" Checked="OnReplaceChanged" Unchecked="OnReplaceChanged" />
                            <local:HelpButton x:Name="LoopHelp" Heading="Seamless loop" Text="{x:Static lib:HelpTexts.SeamlessLoop}" />
                            <local:NumberBox x:Name="LoopFramesBox" Width="48" Text="30" TextChanged="OnReplaceNumbers" ToolTip="The frames blended into the first frame's pose (30 = 0.5 s)" />
                            <TextBlock Text="frames" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="4,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="Root motion" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            <local:NumberBox x:Name="RootScaleBox" Width="48" Text="1" TextChanged="OnReplaceNumbers" ToolTip="How far the source's root travels here: 1 as it is, 0 stays in place (its turn kept)" />
                            <TextBlock Text="x  (0 = stays in place)" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="4,0,0,0" />
                        </StackPanel>
                        <!-- the clip's set: Replace for the whole set (or the clips ticked), lined up so the switches don't jump, and its preview -->
                        <StackPanel x:Name="SetPanel" Margin="0,6,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Set" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <local:HelpButton x:Name="EditSetHelp" Heading="Set" Text="{x:Static lib:HelpTexts.Set}" />
                                <local:HelpButton x:Name="EditProbableSetHelp" Heading="Probable set" Text="{x:Static lib:HelpTexts.ProbableSet}" Visibility="Collapsed" />
                            </StackPanel>
                            <TextBlock x:Name="EditSetText" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Grb.TextSecondary}" Text="-" />
                            <CheckBox x:Name="WholeSetBox" Content="Replace the set: every clip ticked below" Margin="0,2,0,0" IsEnabled="False"
                                      Checked="OnSetChanged" Unchecked="OnSetChanged"
                                      ToolTip="Puts the source on every clip ticked, each fitted to its own length, so the clips the game switches between match." />
                            <StackPanel x:Name="SetOptionsPanel" Visibility="Collapsed" Margin="20,0,0,0">
                                <!-- each clip's piece: where it starts in the source, given or suggested -->
                                <StackPanel x:Name="PieceHead" Orientation="Horizontal">
                                    <TextBlock Text="Each clip, and where its piece starts in the source" FontSize="11" Foreground="{DynamicResource Grb.TextSecondary}" VerticalAlignment="Center" />
                                    <local:HelpButton x:Name="PieceStartHelp" Heading="Start" Text="{x:Static lib:HelpTexts.PieceStart}" />
                                    <Button x:Name="SuggestPiecesButton" Content="Suggest" Click="OnSuggestPieces" Margin="6,0,0,0" Padding="6,0"
                                            ToolTip="Works out every clip's start anew: the pieces sharing as little of the source as their lengths allow, the feet lined up." />
                                </StackPanel>
                                <!-- as tall as its clips: the side panel's own scroll bar scrolls it, the list has none of its own -->
                                <ListBox x:Name="SetClipList" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                         SelectionChanged="OnSetRowChosen" HorizontalContentAlignment="Stretch">
                                    <ListBox.Template>
                                        <ControlTemplate TargetType="ListBox">
                                            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                                                <ItemsPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </ListBox.Template>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <local:NumberBox DockPanel.Dock="Right" Width="56" Text="{Binding Start, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Visibility="{Binding StartShown, Mode=OneWay}" TextChanged="OnPieceStartChanged" Margin="4,0,0,0"
                                                                 ToolTip="{x:Static lib:HelpTexts.PieceStart}" />
                                                <CheckBox IsChecked="{Binding Ticked, Mode=TwoWay}" Checked="OnSetChanged" Unchecked="OnSetChanged">
                                                    <TextBlock FontSize="11" TextTrimming="CharacterEllipsis"><Run Text="{Binding Clip.Name, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Clip.LastTick, Mode=OneWay}" /><Run Text=" ticks" /><Run Text="{Binding SourceText, Mode=OneWay}" Foreground="{DynamicResource Grb.TextSecondary}" /></TextBlock>
                                                </CheckBox>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <WrapPanel>
                                    <RadioButton x:Name="OneSourceChoice" GroupName="SetSource" Content="One source for all" IsChecked="True" Margin="0,0,10,0" Checked="OnSetChanged" />
                                    <RadioButton x:Name="PerClipSourceChoice" GroupName="SetSource" Content="A source per clip" Checked="OnSetChanged"
                                                 ToolTip="Select a clip in the list, then choose its source above (a game clip or a .glb)." />
                                </WrapPanel>
                                <TextBlock x:Name="BlendedOneSourceWarning" Style="{StaticResource Warning}" Margin="0,0,0,2" Visibility="Collapsed" />
                                <CheckBox x:Name="DistinctPiecesBox" Content="Each clip its own piece of the source" IsChecked="True" Checked="OnSetChanged" Unchecked="OnSetChanged"
                                          ToolTip="With Cut and one long source: no two clips take the same piece where the source is long enough, each starting where its piece's loop closes best. Off for a blended set, whose clips need matching poses." />
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="LineUpBox" Content="Line up the set" IsChecked="True" VerticalAlignment="Center" Checked="OnSetChanged" Unchecked="OnSetChanged" />
                                    <local:HelpButton x:Name="LineUpHelp" Heading="Line up the set" Text="{x:Static lib:HelpTexts.LineUpSet}" />
                                </StackPanel>
                                <WrapPanel Margin="20,0,0,0">
                                    <CheckBox x:Name="PoseFrameChoice" Content="On the source's frame" VerticalAlignment="Center" Checked="OnSetChanged" Unchecked="OnSetChanged"
                                              ToolTip="Lines the set up on this frame of the source (the first clip's source); unticked, on the pose closest to all the clips' pieces." />
                                    <local:NumberBox x:Name="PoseFrameBox" Width="56" Text="0" Margin="6,0,0,0" TextChanged="OnReplaceNumbers" />
                                </WrapPanel>
                            </StackPanel>
                            <Button x:Name="PreviewSetButton" Content="Preview the set" HorizontalAlignment="Left" Margin="0,4,0,0" Click="OnPreviewSet" IsEnabled="False"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Plays the set's clips one after another, as the game switches between them, with a short blend between: the results once applied, else the game's own clips." />
                            <TextBlock x:Name="SetResultText" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="TrackMapText" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Grb.TextSecondary}" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>

                <!-- the one step first, in the theme's accent: the edit made and put in the package together; Apply alone to look first -->
                <WrapPanel x:Name="ButtonsPanel" Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="ApplyKeepButton" Content="Apply and add to package" Click="OnApplyAndKeep" IsEnabled="False" ToolTipService.ShowOnDisabled="True"
                            Style="{DynamicResource AccentButtonStyle}" Margin="0,0,6,4" Padding="9,5"
                            ToolTip="Runs the edit in the background and, when it changes the clip, puts the result in the package list (the same one the Import screen adds to); the Package screen writes it out." />
                    <Button x:Name="ApplyButton" Content="Apply" Click="OnApply" IsEnabled="False" ToolTipService.ShowOnDisabled="True" Margin="0,0,6,4" Padding="9,5"
                            ToolTip="Runs the edit in the background without adding it to the package; the result then plays with the original as a ghost." />
                    <Button x:Name="KeepButton" Content="Add to package" Click="OnKeep" IsEnabled="False" ToolTipService.ShowOnDisabled="True" Margin="0,0,0,4" Padding="9,5"
                            ToolTip="Puts the result shown in the package list (the same one the Import screen adds to); the Package screen writes it out." />
                </WrapPanel>
                <StackPanel x:Name="NoticesPanel" Grid.Row="2">
                    <TextBlock x:Name="KeepReasonText" TextWrapping="Wrap" Foreground="{DynamicResource Grb.Warning}" Margin="0,4,0,0" Visibility="Collapsed" />
                    <!-- a result applied but not in the package: said until it is added or another is made -->
                    <TextBlock x:Name="NotKeptText" TextWrapping="Wrap" Foreground="{DynamicResource Grb.Warning}" Margin="0,4,0,0" Visibility="Collapsed"
                               Text="Not in the package yet: press Add to package (Apply and add to package does both in one step)." />
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{DynamicResource Grb.Success}" Margin="0,4,0,0" />
                </StackPanel>

                <DockPanel Grid.Row="3" Margin="0,8,0,0">
                    <StackPanel x:Name="ChecksHead" DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="Checks" FontWeight="SemiBold" FontSize="14" />
                            <local:HelpButton x:Name="ChecksHelp" Heading="Checks" Text="{x:Static lib:HelpTexts.Checks}" />
                        </StackPanel>
                        <TextBlock x:Name="VerdictText" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,4" Text="Nothing applied yet." />
                    </StackPanel>
                    <!-- the right padding keeps the checks' text clear of the theme's scroll bar, which lies over the list's right edge; the
                         checks in the size of text they had before the theme (its 14 shows two of the nine where 12 showed six) -->
                    <ListBox x:Name="ReportList" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderBrush="{DynamicResource Grb.ListBorder}" BorderThickness="1"
                             Padding="0,0,10,0" FontSize="12">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <Border DockPanel.Dock="Left" Style="{StaticResource Badge}" Margin="0,0,6,0" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Word}" Style="{StaticResource BadgeWord}" />
                                    </Border>
                                    <local:HelpButton DockPanel.Dock="Right" VerticalAlignment="Top" Heading="Feet slide" Text="{Binding Help, Mode=OneWay}" Visibility="{Binding HelpShown, Mode=OneWay}" />
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="{Binding Check, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Text, Mode=OneWay}" />
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                <Expander x:Name="NotesExpander" Grid.Row="4" Header="What the edit did and kept" Margin="0,6,0,0" IsExpanded="False">
                    <ListBox x:Name="NotesList" MaxHeight="160" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Expander>
            </Grid>
        </Grid>
        </local:FitScroll>
    </Grid>
</UserControl>
