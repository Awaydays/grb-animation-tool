<UserControl x:Class="GrbAnimTool.App.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GrbAnimTool.App"
             xmlns:index="clr-namespace:GrbAnimTool.Core.Index;assembly=GrbAnimTool.Core">
    <UserControl.Resources>
        <!-- the styles build on the theme's own (BasedOn), so the controls keep its look in light and dark -->
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource Grb.TextSecondary}" />
            <Setter Property="Margin" Value="0,3,8,3" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Margin" Value="0,3,0,3" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- the game folder and the install's summary -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="ChooseButton" Grid.Column="0" Content="Choose game folder..." Click="OnChooseFolder"
                    ToolTip="The Ghost Recon Breakpoint folder that holds GRB.exe. The tool only reads it." />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0">
                <TextBlock x:Name="FolderText" Text="No game folder chosen yet." TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SummaryText" Foreground="{DynamicResource Grb.TextSecondary}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="IndexText" Foreground="{DynamicResource Grb.TextSecondary}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel x:Name="BusyPanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                <ProgressBar IsIndeterminate="True" Width="140" Height="14" Margin="0,0,8,0" />
                <TextBlock x:Name="BusyText" Text="Opening the game folder..." />
            </StackPanel>
            <!-- the clip index, built (or read from its cache) in the background while the list is in use -->
            <StackPanel x:Name="IndexPanel" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed"
                        ToolTip="Who plays each clip and what it is, from the game's animation graph, the tool's list and the clips' names. Built the first time a game folder is opened, then read from the cache in the tool's settings folder until the game files change.">
                <ProgressBar x:Name="IndexBar" Minimum="0" Maximum="1" Width="140" Height="14" Margin="0,0,8,0" />
                <TextBlock x:Name="IndexBusyText" Text="Clip index..." />
            </StackPanel>
        </Grid>

        <!-- errors, shown in the window -->
        <Border x:Name="ErrorBox" Grid.Row="1" Background="{DynamicResource Grb.ErrorBack}" BorderBrush="{DynamicResource Grb.ErrorBorder}" BorderThickness="1" Padding="8,5" Margin="0,0,0,6"
                Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Dismiss" Click="OnDismissError" Margin="8,0,0,0" VerticalAlignment="Top" />
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource Grb.Error}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- the panes fill the window's height, and scroll in a window too short for their least height (every control reachable) -->
        <local:FitScroll x:Name="PaneScroll" Grid.Row="2">
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- in proportion, so all three panes stay in the window down to its least size -->
                <ColumnDefinition Width="700*" MinWidth="300" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="470*" MinWidth="300" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="290*" MinWidth="180" />
            </Grid.ColumnDefinitions>

            <!-- the clip list with its search and filters, the one every screen uses -->
            <local:ClipListPanel x:Name="ClipPanel" Grid.Column="0" />

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{DynamicResource Grb.Splitter}" />

            <!-- the viewport and its timeline -->
            <Grid x:Name="ViewerPane" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <WrapPanel Grid.Row="0" Margin="0,0,0,4">
                    <CheckBox x:Name="MoverBox" Content="Mover" IsChecked="True" Margin="0,3,12,3" Click="OnMoverToggled" Focusable="False"
                              ToolTip="On: the clip travels and turns on its mover (its root motion), and its path shows on the floor. Off: the clip plays in place." />
                    <CheckBox x:Name="FollowBox" Content="Follow character" IsChecked="True" Margin="0,3,12,3" Click="OnFollowToggled" Focusable="False"
                              ToolTip="Keep the camera on the character as it travels." />
                    <Button Content="Reset camera" Click="OnResetCamera" Focusable="False" />
                    <TextBlock Text="Left drag: orbit · right or middle drag: pan · wheel: zoom" Foreground="{DynamicResource Grb.TextSecondary}" VerticalAlignment="Center" Margin="8,0,0,0" />
                </WrapPanel>
                <Border x:Name="ViewFrame" Grid.Row="1" BorderBrush="{DynamicResource Grb.ViewBorder}" BorderThickness="1">
                    <Grid>
                        <!-- the surface takes the mouse (a Viewport3D is hit only where something is drawn), and the focus when clicked, so
                             Space, Left and Right reach the timeline from there -->
                        <Border x:Name="ViewSurface" Background="{DynamicResource Grb.ViewBack}" ClipToBounds="True" Focusable="True" FocusVisualStyle="{x:Null}">
                            <Viewport3D x:Name="Viewport" IsHitTestVisible="False" ClipToBounds="True">
                                <ModelVisual3D>
                                    <ModelVisual3D.Content>
                                        <Model3DGroup>
                                            <AmbientLight Color="#FF505050" />
                                            <DirectionalLight Color="#FFC8C8C8" Direction="-0.4,-0.6,-1" />
                                            <DirectionalLight Color="#FF707070" Direction="0.5,0.7,-0.3" />
                                        </Model3DGroup>
                                    </ModelVisual3D.Content>
                                </ModelVisual3D>
                            </Viewport3D>
                        </Border>
                        <local:SketchLayer x:Name="Sketch" Visibility="Collapsed" />
                        <TextBlock x:Name="OverlayText" Foreground="{DynamicResource Grb.ViewText}" Margin="10,8" VerticalAlignment="Top" HorizontalAlignment="Left"
                                   IsHitTestVisible="False" FontFamily="Consolas" />
                        <TextBlock x:Name="HintText" Foreground="{DynamicResource Grb.ViewHint}" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   IsHitTestVisible="False" Text="Choose your game folder to begin." />
                    </Grid>
                </Border>
                <Grid Grid.Row="3" Margin="0,6,0,0" PreviewMouseDown="OnTimelineMouseDown" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- the clip's events (top) and its feet's plants (left foot, then right) over the slider's track, both the row's whole width -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="events · plants L/R" Foreground="{DynamicResource Grb.TextSecondary}" FontSize="10" VerticalAlignment="Center"
                               HorizontalAlignment="Right" Margin="0,0,4,2" />
                    <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Height="24" Margin="4,0,8,2" Background="{DynamicResource Grb.Strip}" BorderBrush="{DynamicResource Grb.StripBorder}" BorderThickness="1">
                        <Canvas x:Name="MarkStrip" Margin="5,0,5,0" ClipToBounds="True" SizeChanged="OnMarkStripSized" Background="Transparent" />
                    </Border>
                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                        <Button x:Name="StepBackButton" Content="◀|" Click="OnStepBack" ToolTip="One tick back (Left arrow)" Focusable="False" />
                        <Button x:Name="PlayButton" Content="▶ Play" Width="80" Click="OnPlayPause" ToolTip="Play or pause (Space)" Focusable="False" />
                        <Button x:Name="StepForwardButton" Content="|▶" Click="OnStepForward" ToolTip="One tick forward (Right arrow)" Focusable="False" />
                    </StackPanel>
                    <Slider x:Name="TimeSlider" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Minimum="0" Maximum="1" VerticalAlignment="Center" Margin="4,0,8,0"
                            ValueChanged="OnScrub" SmallChange="0.0166667" LargeChange="0.5" IsMoveToPointEnabled="True" Focusable="False" />
                    <WrapPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                        <TextBlock x:Name="TimeText" Width="190" FontFamily="Consolas" VerticalAlignment="Center" Text="0.000 s  tick 0 / 0" />
                        <CheckBox x:Name="LoopBox" Content="Loop" IsChecked="True" Margin="6,0,10,0" VerticalAlignment="Center" Click="OnLoopToggled" Focusable="False" />
                        <TextBlock Text="Speed" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <ComboBox x:Name="SpeedBox" Width="80" SelectionChanged="OnSpeedChanged" Focusable="False">
                            <ComboBoxItem Content="0.25x" />
                            <ComboBoxItem Content="0.5x" />
                            <ComboBoxItem Content="1x" IsSelected="True" />
                            <ComboBoxItem Content="2x" />
                        </ComboBox>
                        <TextBlock x:Name="MarkText" Foreground="{DynamicResource Grb.TextSecondary}" FontSize="10" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </WrapPanel>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="{DynamicResource Grb.Splitter}" />

            <!-- the selected clip's facts and the export buttons -->
            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto" Margin="6,0,0,0">
                <!-- the right margin keeps the values clear of the theme's scroll bar, which lies over the panel's right edge -->
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Clip" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" />
                    <Grid x:Name="InfoGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Name" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="InfoName" Style="{StaticResource Value}" Text="-" />
                        <TextBlock Grid.Row="1" Text="Readable name" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="InfoReadable" Style="{StaticResource Value}" Text="-"
                                   ToolTip="The clip's readable name, from the tool's list (none where it gives none)." />
                        <TextBlock Grid.Row="2" Text="ID" Style="{StaticResource Label}" />
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="InfoId" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" MinHeight="0" Margin="0,3" Text="-" FontFamily="Consolas" />
                        <TextBlock Grid.Row="3" Text="Index" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="InfoIndex" Style="{StaticResource Value}" Text="-" />
                        <TextBlock Grid.Row="4" Text="Length" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="InfoDuration" Style="{StaticResource Value}" Text="-" />
                        <TextBlock Grid.Row="5" Text="Ticks" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="InfoTicks" Style="{StaticResource Value}" Text="-" />
                        <TextBlock Grid.Row="6" Text="Tracks" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="6" Grid.Column="1" x:Name="InfoTracks" Style="{StaticResource Value}" Text="-" />
                        <TextBlock Grid.Row="7" Text="Rotation" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="7" Grid.Column="1" x:Name="InfoRot" Style="{StaticResource Value}" Text="-" />
                        <TextBlock Grid.Row="8" Text="Position" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="8" Grid.Column="1" x:Name="InfoPos" Style="{StaticResource Value}" Text="-" />
                        <TextBlock Grid.Row="9" Text="Other" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="9" Grid.Column="1" x:Name="InfoOther" Style="{StaticResource Value}" Text="-" />
                        <TextBlock Grid.Row="10" Text="Mover" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="10" Grid.Column="1" x:Name="InfoMover" Style="{StaticResource Value}" Text="-" />
                        <TextBlock Grid.Row="11" Text="Status" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="11" Grid.Column="1" x:Name="InfoStatus" Style="{StaticResource Value}" Text="-" />
                        <!-- the clip index: each category with the source that decided it (hover for the reason), and the graph's documents naming the clip -->
                        <TextBlock Grid.Row="12" Text="Who" Style="{StaticResource Label}" />
                        <StackPanel Grid.Row="12" Grid.Column="1" x:Name="InfoWho" Margin="0,3" />
                        <!-- who plays the clip in one line, "probably" for who only its name or a machine several layers share gives (or the name's family makes unlikely):
                             a replaced clip changes for all of them -->
                        <TextBlock x:Name="InfoPlayedByLabel" Grid.Row="13" Text="Played by" Style="{StaticResource Label}"
                                   ToolTip="{x:Static index:ClipUsers.PlayedByTip}" />
                        <TextBlock Grid.Row="13" Grid.Column="1" x:Name="InfoPlayedBy" Style="{StaticResource Value}" Text="-" />
                        <TextBlock Grid.Row="14" Text="What" Style="{StaticResource Label}" />
                        <StackPanel Grid.Row="14" Grid.Column="1" x:Name="InfoWhat" Margin="0,3" />
                        <TextBlock Grid.Row="15" Text="Used by" Style="{StaticResource Label}"
                                   ToolTip="The game's animation graph documents (its state machines and layers) that name the clip; a number in brackets: that many documents of that name." />
                        <TextBlock Grid.Row="15" Grid.Column="1" x:Name="InfoUsedBy" Style="{StaticResource Value}" Text="-" />
                    </Grid>
                    <TextBlock x:Name="InfoNote" TextWrapping="Wrap" Foreground="{DynamicResource Grb.Error}" Margin="0,6,0,0" />

                    <TextBlock Text="Export" FontWeight="SemiBold" FontSize="14" Margin="0,16,0,4" />
                    <Button x:Name="SkeletonExportButton" Content="Skeleton .glb..." IsEnabled="False" HorizontalAlignment="Stretch" Margin="0,0,0,4"
                            Click="OnExportSkeleton" ToolTipService.ShowOnDisabled="True" Focusable="False"
                            ToolTip="Saves the skeleton (the body and the fake-gun add-on, 75 bones) at its rest pose as a glTF binary file." />
                    <Button x:Name="ClipExportButton" Content="Clip .glb..." IsEnabled="False" HorizontalAlignment="Stretch" Margin="0,0,0,4"
                            Click="OnExportClip" ToolTipService.ShowOnDisabled="True" Focusable="False"
                            ToolTip="Saves the clip shown as a glTF binary file (the skeleton and the clip at 60 frames a second, the mover on the armature) with a .grbanim.json beside it for what glTF can't hold." />
                    <TextBlock x:Name="ExportText" TextWrapping="Wrap" Foreground="{DynamicResource Grb.Success}" Margin="0,2,0,0" />

                    <TextBlock Text="Colours" FontWeight="SemiBold" FontSize="14" Margin="0,16,0,4" />
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Grb.TextSecondary}"
                               Text="Blue joints and pale sticks: the body. Orange: the fake-gun add-on's bones, shown where the clip keys them (with the add-on bones under those). Those hanging straight from the body get no stick to it: some are helpers that the clip parks at fixed points in its world (in some death clips about a metre up, where the character stood), not parts of the body. Grey: root frames. Green arrow: the mover, the way the character faces. Yellow line: the mover's path. Cyan rings: a foot the clip holds planted (its plant tracks), with its spans on the strip over the timeline. Red rings: a foot joint more than 2 cm below the floor. Orange marks on the strip: the clip's events at their times (hover one for its class)." />
                </StackPanel>
            </ScrollViewer>
        </Grid>
        </local:FitScroll>
    </Grid>
</UserControl>
