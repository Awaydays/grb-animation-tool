<UserControl x:Class="GrbAnimTool.App.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GrbAnimTool.App">
    <UserControl.Resources>
        <!-- the styles build on the theme's own (BasedOn), so the controls keep its look in light and dark -->
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource Grb.TextSecondary}" />
            <Setter Property="Margin" Value="0,3,8,3" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <!-- a line's clip: its name, or in italics a word for a line that names none of the install's clips -->
        <DataTemplate x:Key="ClipCell">
            <TextBlock Text="{Binding ClipText}" ToolTip="{Binding Tip}" TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Opens}" Value="False">
                                <Setter Property="FontStyle" Value="Italic" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="TimeCell">
            <TextBlock Text="{Binding TimeText}" ToolTip="{Binding Tip}" FontFamily="Consolas" />
        </DataTemplate>
        <DataTemplate x:Key="CharacterCell">
            <TextBlock Text="{Binding CharacterText}" ToolTip="{Binding Tip}" />
        </DataTemplate>
        <DataTemplate x:Key="SourceCell">
            <TextBlock Text="{Binding SourceText}" ToolTip="{Binding Tip}" />
        </DataTemplate>
        <DataTemplate x:Key="IdCell">
            <TextBlock Text="{Binding IdText}" ToolTip="{Binding Tip}" FontFamily="Consolas" />
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- the log: one opened, or the newest in a folder followed as the game writes it -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                <Button x:Name="OpenButton" Content="Open log..." Click="OnOpenLog"
                        ToolTip="Opens a clip log (.csv) of the GRB Clip Logger. The tool only reads it, and keeps reading it as it grows." />
                <CheckBox x:Name="FollowBox" Content="Follow the newest log" Margin="4,0,10,0" VerticalAlignment="Center" Click="OnFollowToggled"
                          ToolTip="Shows the newest clip log in the folder below as the game writes it, and switches to a newer one when the logger starts it. Nothing is ever made or written in the folder." />
                <Button x:Name="FolderButton" Content="Change folder..." Click="OnChooseFolder"
                        ToolTip="The folder whose newest log is followed: by default &quot;GRB - Animation logging&quot; in your Documents folder, where the logger writes. Remembered for the next run." />
            </WrapPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0">
                <TextBlock x:Name="SourceText" TextTrimming="CharacterEllipsis" Text="No log open." />
                <TextBlock x:Name="FolderText" Foreground="{DynamicResource Grb.TextSecondary}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <!-- errors, shown in the window -->
        <Border x:Name="ErrorBox" Grid.Row="1" Background="{DynamicResource Grb.ErrorBack}" BorderBrush="{DynamicResource Grb.ErrorBorder}" BorderThickness="1" Padding="8,5" Margin="0,0,0,6"
                Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Dismiss" Click="OnDismissError" Margin="8,0,0,0" VerticalAlignment="Top" />
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource Grb.Error}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- the filter, a long read's progress, and the logger's size limit when the log reached it -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,4">
            <TextBlock Text="Show" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="ShowBox" Width="190" SelectionChanged="OnShowChanged" Margin="0,0,12,0"
                      ToolTip="Every clip start the log holds, or the player's character's only (the logger logs the player only unless its Characters setting says All characters)">
                <ComboBoxItem Content="All characters" IsSelected="True" />
                <ComboBoxItem Content="The player only" />
            </ComboBox>
            <StackPanel x:Name="LoadPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed">
                <ProgressBar x:Name="LoadBar" Minimum="0" Maximum="1" Width="140" Height="14" Margin="0,0,8,0" />
                <TextBlock x:Name="LoadText" Text="Reading the log..." />
            </StackPanel>
            <TextBlock x:Name="LimitText" Foreground="{DynamicResource Grb.Warning}" VerticalAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed" />
        </WrapPanel>

        <!-- a line per clip start; a click on one shows its clip in the Library -->
        <ListView x:Name="List" Grid.Row="3" SelectionMode="Single" Padding="0,0,0,12"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.IsDeferredScrollingEnabled="False">
            <ListView.View>
                <!-- the clip index's readable name and who go in after the clip: see IndexColumns -->
                <GridView>
                    <GridViewColumn Width="108" CellTemplate="{StaticResource TimeCell}">
                        <GridViewColumnHeader Content="Time" ToolTip="When the clip started, by your PC's clock (hover a line for its date and the seconds since the log started)" />
                    </GridViewColumn>
                    <GridViewColumn Width="{x:Static local:ClipListPanel.NameWidth}" CellTemplate="{StaticResource ClipCell}">
                        <GridViewColumnHeader Content="Clip" ToolTip="The clip's name in your game files, looked up by the ID the log gives. Unknown clip: the ID isn't one of their clips, and the tool doesn't guess a name." />
                    </GridViewColumn>
                    <GridViewColumn Width="80" CellTemplate="{StaticResource CharacterCell}">
                        <GridViewColumnHeader Content="Character" ToolTip="player: your character; other: any other character (logged when the logger's Characters setting says All characters)" />
                    </GridViewColumn>
                    <GridViewColumn Width="62" CellTemplate="{StaticResource SourceCell}">
                        <GridViewColumnHeader Content="Source" ToolTip="What started the clip: clip (an animation state), layer (an animation layer), motion (a motion-matching jump) or other (a place in the game's code the logger doesn't name: hover the line for it)" />
                    </GridViewColumn>
                    <GridViewColumn Width="150" CellTemplate="{StaticResource IdCell}">
                        <GridViewColumnHeader Content="Clip ID" ToolTip="The clip's ID as the log gives it, the same as the Library shows" />
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock x:Name="CountText" Grid.Row="4" Foreground="{DynamicResource Grb.TextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap" />

        <!-- the log's notes (its start, settings, the player's character found, marks, the summary at its end), dimmed, in order -->
        <StackPanel Grid.Row="5" Margin="0,6,0,0">
            <TextBlock Text="Notes in the log" Style="{StaticResource Label}" Margin="0,0,0,2" />
            <Border BorderBrush="{DynamicResource Grb.StripBorder}" BorderThickness="1">
                <ItemsControl x:Name="NotesList" Height="88" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True" Focusable="False">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4,2,14,2" Focusable="False">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Tip}" ToolTip="{Binding Tip}" Foreground="{DynamicResource Grb.TextSecondary}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
