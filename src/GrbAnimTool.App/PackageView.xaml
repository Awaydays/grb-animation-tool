<UserControl x:Class="GrbAnimTool.App.PackageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GrbAnimTool.App"
             xmlns:index="clr-namespace:GrbAnimTool.Core.Index;assembly=GrbAnimTool.Core">
    <UserControl.Resources>
        <!-- the styles build on the theme's own (BasedOn), so the controls keep its look in light and dark -->
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource Grb.TextSecondary}" />
            <Setter Property="Margin" Value="0,3,8,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <!-- a file's second line: what it is, in the secondary colour, and in the selected row's own when its row is selected -->
        <Style x:Key="FileNote" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource Grb.TextSecondary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Grb.SelectedTextSecondary}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,6">
            <TextBlock x:Name="SummaryText" FontWeight="SemiBold" TextWrapping="Wrap" Text="Open your game folder on the Library screen first." />
            <TextBlock Foreground="{DynamicResource Grb.TextSecondary}" TextWrapping="Wrap"
                       Text="A package is one folder of the package's name inside a folder you pick, never one of the game's: the record files of the clips you added (imports and edits), the folder &quot;Original clips&quot; with the game's own record of each clip it replaces (copied over the package's files, they uninstall it), and the tool's marker file. The original clips come from your game folder; where it holds a modded clip, from a vanilla backup of DataPC_patch_01.forge you name, or the game's base files (which on today's game files hold none). A clip whose original isn't found is packaged without it, and named here." />
            <!-- the list kept from the last run: what came back, and what was left out and why -->
            <TextBlock x:Name="RestoreText" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" Foreground="{DynamicResource Grb.TextSecondary}" />
            <TextBlock x:Name="DroppedText" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed" Foreground="{DynamicResource Grb.Warning}" />
            <Button x:Name="ForgetButton" Content="Forget these" Click="OnForget" HorizontalAlignment="Left" Margin="0,4,0,0" Visibility="Collapsed"
                    ToolTip="Takes the kept clips that don't fit these game files out of the kept file for good. The package's own list and the lists kept for other game files stay." />
        </StackPanel>

        <Border x:Name="ErrorBox" Grid.Row="1" Background="{DynamicResource Grb.ErrorBack}" BorderBrush="{DynamicResource Grb.ErrorBorder}" BorderThickness="1" Padding="8,5" Margin="0,0,0,6"
                Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Dismiss" Click="OnDismissError" Margin="8,0,0,0" VerticalAlignment="Top" />
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource Grb.Error}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- the panes fill the window's height, and scroll in a window too short for their least height (every control reachable) -->
        <local:FitScroll x:Name="PaneScroll" Grid.Row="2">
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- in proportion, so both panes stay in the window down to its least size -->
                <!-- the list all the room the name, folders and files leave (their least width), so at the window's usual size the four
                     common columns, the checks, who plays each clip and the change are in sight (the warnings a sideways scroll away) -->
                <ColumnDefinition Width="1100*" MinWidth="300" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="360*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- what's in it: the clip list every screen uses, its clips the ones kept, with the package's own columns (its checks, who
                 plays each clip, what was changed in it and its warnings) after the four every list has; after a build, what it built
                 until a clip is kept again -->
            <DockPanel x:Name="ItemsPane" Grid.Column="0">
                <TextBlock x:Name="ItemsTitle" DockPanel.Dock="Top" Text="In the package" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" />
                <StackPanel x:Name="RemoveRow" DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="RemoveButton" Content="Remove" Click="OnRemove" IsEnabled="False" ToolTipService.ShowOnDisabled="True"
                            ToolTip="Takes the selected clip out of the package." />
                    <TextBlock x:Name="CountText" Foreground="{DynamicResource Grb.TextSecondary}" VerticalAlignment="Center" />
                </StackPanel>
                <local:ClipListPanel x:Name="ItemsPanel" />
            </DockPanel>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{DynamicResource Grb.Splitter}" />

            <!-- its name, where it goes, the files, Build -->
            <Grid x:Name="BuildPane" Grid.Column="2" Margin="6,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="SettingsGrid" Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Name" Style="{StaticResource Label}" />
                    <TextBox x:Name="NameBox" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,2" Text="My animation package" TextChanged="OnSettingsChanged"
                             ToolTip="The package's name: its folder is named after it." />
                    <TextBlock Grid.Row="1" Text="Save folder" Style="{StaticResource Label}" />
                    <TextBox x:Name="FolderBox" Grid.Row="1" Grid.Column="1" Margin="0,2" TextChanged="OnSettingsChanged"
                             ToolTip="A folder of your own. The package's folder is made inside it. The game's folders are refused." />
                    <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Click="OnBrowse" Margin="6,2,0,2" />
                    <CheckBox x:Name="ReplaceBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4"
                              Click="OnSettingsChanged" ToolTip="When the package's folder holds an earlier build of this package made by this tool (its marker file and only a package's files), it is replaced whole. Any other folder is refused.">
                        <TextBlock Text="Replace an earlier build of this package" TextWrapping="Wrap" />
                    </CheckBox>
                    <!-- a vanilla backup of the patch forge, for the originals of the slots the install holds modded clips in; remembered between runs -->
                    <TextBlock Grid.Row="3" Text="Vanilla forge backup" Style="{StaticResource Label}" TextWrapping="Wrap" MaxWidth="90" />
                    <TextBox x:Name="BackupBox" Grid.Row="3" Grid.Column="1" Margin="0,2" IsReadOnly="True"
                             ToolTip="A copy of DataPC_patch_01.forge as the game shipped it (before any mod), kept outside the game folder. Where your game folder holds a modded clip, its original is taken from here, each record checked against the game's own. Empty: none; such a clip is then packaged without its original, named on this screen." />
                    <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal" Margin="6,2,0,2">
                        <Button Content="Browse..." Click="OnBrowseBackup" Margin="0,0,6,0" ToolTip="Choose the vanilla backup of DataPC_patch_01.forge." />
                        <Button x:Name="ClearBackupButton" Content="Clear" Click="OnClearBackup" Margin="0" IsEnabled="False" ToolTip="No backup: the originals come from your game folder and the game's base files only." />
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="FilesTitle" Grid.Row="1" Text="The files that will be written" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,4" />
                <DockPanel Grid.Row="2">
                    <TextBlock x:Name="PlanFolderText" DockPanel.Dock="Top" TextWrapping="Wrap" FontFamily="Consolas" Margin="0,0,0,4" />
                    <TextBlock x:Name="ProblemText" DockPanel.Dock="Bottom" TextWrapping="Wrap" Foreground="{DynamicResource Grb.Warning}" Margin="0,4,0,0" />
                    <!-- the right padding keeps the files' notes clear of the theme's scroll bar, which lies over the list's right edge -->
                    <ListBox x:Name="FileList" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderBrush="{DynamicResource Grb.ListBorder}" BorderThickness="1"
                             Padding="0,0,10,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,1">
                                    <TextBlock Text="{Binding Name}" FontFamily="Consolas" />
                                    <TextBlock Text="{Binding What}" Style="{StaticResource FileNote}" FontSize="11" TextWrapping="Wrap" Margin="12,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                <StackPanel x:Name="BuildRow" Grid.Row="3" Margin="0,8,0,0">
                    <!-- where the original clips come from, and each clip packaged without one: a warning, never in the way of Build -->
                    <TextBlock x:Name="OriginalsText" TextWrapping="Wrap" Foreground="{DynamicResource Grb.Warning}" Margin="0,0,0,6" Visibility="Collapsed" />
                    <!-- before Build: the clips more than one kind of character plays (or none the tool can place); it never stops the build -->
                    <TextBlock x:Name="UsersNotice" TextWrapping="Wrap" Foreground="{DynamicResource Grb.Warning}" Margin="0,0,0,6" Visibility="Collapsed"
                               ToolTip="{x:Static index:ClipUsers.PlayedByTip}" />
                    <!-- while the clip index is read: Build waits for it, greyed, so nothing is written before the notice says who plays each clip -->
                    <DockPanel x:Name="WaitPanel" Margin="0,0,0,6" Visibility="Collapsed">
                        <ProgressBar x:Name="WaitBar" DockPanel.Dock="Left" Minimum="0" Maximum="1" Width="120" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="WaitText" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BuildButton" Content="Build" Width="100" Click="OnBuild" IsEnabled="False" ToolTipService.ShowOnDisabled="True"
                                ToolTip="Writes every file above: all of them or none." />
                        <StackPanel x:Name="BusyPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                            <ProgressBar IsIndeterminate="True" Width="120" Height="14" Margin="0,0,8,0" />
                            <TextBlock Text="Building..." />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="ResultText" TextWrapping="Wrap" Foreground="{DynamicResource Grb.Success}" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
        </local:FitScroll>
    </Grid>
</UserControl>
